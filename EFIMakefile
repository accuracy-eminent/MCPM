# Run: sudo apt install gnu-efi build-essential gcc-mingw-w64-x86-64
# Also: sudo apt install clang lld ovmf
# This uses POSIX-UEFI: https://gitlab.com/bztsrc/posix-uefi/
QEMU=qemu-system-x86_64.exe
BIOS=./OVMF.fd
CFLAGS=-std=gnu89 -Wno-return-type -DEFI_ON -DRLI
LDFLAGS=-Wl,--no-as-needed
TARGET=BOOTX64.EFI


include uefi/Makefile

clean2:
	rm -fv *.o
qemu:
	mkdir -pv tmpefi/efi/boot
	cp ${TARGET} tmpefi/efi/boot/BOOTX64.EFI
	${QEMU} -bios ${BIOS} -drive file=fat:rw:tmpefi,format=raw
.PHONY: clean2 qemu